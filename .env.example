# =============================================================================
# FieldOps Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values

# --- General ---
NODE_ENV=development
APP_PORT=3001

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fieldops
DB_PASSWORD=fieldops_secret
DB_NAME=fieldops_db
DB_SSL=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# --- Mapbox ---
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here
MAPBOX_SECRET_TOKEN=sk.your_mapbox_secret_token_here

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# --- Web App (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# --- Mobile App (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_WS_URL=http://localhost:3001

# --- BullMQ ---
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379

# --- File Storage (optional S3 for photo uploads) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=fieldops-uploads
AWS_S3_REGION=us-east-1
